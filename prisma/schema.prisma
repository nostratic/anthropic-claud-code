generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  createdConflicts Conflict[]            @relation("ConflictCreator")
  participations   ConflictParticipant[]
  createdRoadmaps  Roadmap[]             @relation("RoadmapCreator")
  notes            Note[]
  statusChanges    NodeStatusHistory[]
  sharedRoadmapsTo RoadmapShare[]        @relation("SharedTo")
  sharedRoadmapsBy RoadmapShare[]        @relation("SharedBy")
}

model Conflict {
  id          String   @id @default(cuid())
  title       String
  description String
  status      String   @default("open")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy    User                  @relation("ConflictCreator", fields: [createdById], references: [id])
  participants ConflictParticipant[]
  roadmaps     Roadmap[]
  notes        Note[]
}

model ConflictParticipant {
  id         String   @id @default(cuid())
  conflictId String
  userId     String
  role       String   @default("member")
  joinedAt   DateTime @default(now())

  conflict Conflict @relation(fields: [conflictId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conflictId, userId])
}

model Roadmap {
  id          String   @id @default(cuid())
  conflictId  String
  createdById String
  title       String
  type        String   @default("linear")
  isActive    Boolean  @default(false)
  isPersonal  Boolean  @default(false)
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conflict  Conflict       @relation(fields: [conflictId], references: [id], onDelete: Cascade)
  createdBy User           @relation("RoadmapCreator", fields: [createdById], references: [id])
  nodes     RoadmapNode[]
  shares    RoadmapShare[]
}

model RoadmapNode {
  id          String  @id @default(cuid())
  roadmapId   String
  title       String
  description String?
  type        String  @default("step")
  positionX   Float   @default(0)
  positionY   Float   @default(0)
  order       Int     @default(0)
  status      String  @default("pending")
  parentId    String?

  cost          Float?
  timeEstimate  String?
  points        Int     @default(10)
  consequences  String?
  prerequisites String?
  assumptions   String?
  kpis          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roadmap       Roadmap             @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  parent        RoadmapNode?        @relation("NodeChildren", fields: [parentId], references: [id])
  children      RoadmapNode[]       @relation("NodeChildren")
  statusHistory NodeStatusHistory[]
  files         NodeFile[]
}

model NodeStatusHistory {
  id        String   @id @default(cuid())
  nodeId    String
  userId    String
  oldStatus String
  newStatus String
  comment   String?
  changedAt DateTime @default(now())

  node RoadmapNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id])
}

model NodeFile {
  id           String   @id @default(cuid())
  nodeId       String
  uploadedById String
  name         String
  url          String
  fileType     String   @default("file")
  visibility   String   @default("all")
  uploadedAt   DateTime @default(now())

  node RoadmapNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

model Note {
  id         String   @id @default(cuid())
  userId     String
  conflictId String
  content    String
  isShared   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  conflict Conflict @relation(fields: [conflictId], references: [id], onDelete: Cascade)
}

model RoadmapShare {
  id         String   @id @default(cuid())
  roadmapId  String
  sharedById String
  sharedToId String
  status     String   @default("pending")
  sharedAt   DateTime @default(now())

  roadmap  Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  sharedBy User    @relation("SharedBy", fields: [sharedById], references: [id])
  sharedTo User    @relation("SharedTo", fields: [sharedToId], references: [id])

  @@unique([roadmapId, sharedToId])
}
